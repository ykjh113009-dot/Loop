# Copy this file to ".env.local" and fill in the values.
# For local development, `npx supabase status` prints the Supabase values.

# Supabase project URL and publishable (public) key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret key. Only used on the server to send phone notifications.
# Never share it and never put NEXT_PUBLIC_ in front of it.
SUPABASE_SECRET_KEY=sb_secret_...

# Shows "Sign in as a demo student" buttons on the login page.
# Turn this OFF (false) on the real school site.
DEMO_MODE=true
DEMO_PASSWORD=pbsgo-demo

# Optional: makes the Google sign-in screen suggest school accounts only.
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=pioneers.edu.ps

# Optional: phone push notifications. Generate keys with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# A long random password that protects the push-sending link.
CRON_SECRET=change-me-to-a-long-random-string
